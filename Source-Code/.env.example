# Copy this file to .env and fill in your keys.  Never commit .env.

ENV=dev
# Any long random string (at least 32 characters). Required when ENV=production.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-characters

# Admin account created on first start (open the System page with it)
ADMIN_EMAIL=admin@neurolens.local
ADMIN_PASSWORD=Admin12345

# ---- LLM key pool: tried in this order; a failing key cools down and the next one answers ----
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# "auto" = each key asks Google which models it can use and picks the best one (recommended).
# You can also pin names, e.g. GEMINI_MODEL=gemini-3.8-flash — or change them later on Admin → API keys.
GEMINI_MODEL=auto
GEMINI_FALLBACK_MODEL=auto

# Keys starting with gsk_ are used with Groq (api.groq.com); keys starting with xai- with xAI Grok (api.x.ai)
GROK_API_KEY_1=
GROK_API_KEY_2=
GROK_API_KEY_3=
GROQ_MODEL=auto
XAI_MODEL=auto

# Web search fallback for medical terms not in the knowledge base
SERPER_API_KEY=

# Official MCP fetch server (mcp-server-fetch) for PubMed + MedlinePlus. false = direct HTTPS.
USE_MCP=true

# ---- Fine-tuned patient-friendly explainer (LLM Engineering project) ----
# router = patient view uses the key pool with the training prompt (no GPU needed)
# local  = Qwen2.5-0.5B + your SFT and DPO adapters (pip install -r requirements-ml.txt)
EXPLAINER_MODE=router
BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
SFT_ADAPTER=
DPO_ADAPTER=

# ---- Key pool timing ----
# Seconds to wait for one model answer (v2.1: 45; Gemini thinking is set to "low" so answers arrive well before this)
LLM_TIMEOUT_S=45
# Seconds a rate-limited model / failing key rests before it is tried again
LLM_COOLDOWN_S=60

# ---- Photo reports (OCR) ----
# gemini = Gemini vision through the key pool; tesseract = local (Mac: brew install tesseract)
OCR_ENGINES=gemini,tesseract
# Generated PDFs can be downloaded for this many hours
EXPORT_TTL_HOURS=24

# ---- Brain MRI classifier ----
MRI_MODEL_PATH=models/mri_classifier.pt
MRI_MIN_CONFIDENCE=0.60
